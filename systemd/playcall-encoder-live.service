[Unit]
Description=PlayCall Encoder - Multi-View push to the site's stream server
After=playcall-encoder-mediamtx.service network-online.target
Wants=playcall-encoder-mediamtx.service network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 -m encoder.live_push
WorkingDirectory=/opt/playcall-encoder
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
# Reads /etc/playcall-encoder/config.json (root:playcall 640) and the
# ingest ticket cloud_link leaves in /run/playcall-encoder; writes its own
# status back there.
User=playcall
Group=playcall
RuntimeDirectory=playcall-encoder
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
