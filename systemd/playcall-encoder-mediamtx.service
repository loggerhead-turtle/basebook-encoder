[Unit]
Description=PlayCall Encoder - MediaMTX ingest/recorder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/local/bin/mediamtx /etc/playcall-encoder/mediamtx.yml
Restart=always
RestartSec=2
User=playcall
Group=playcall
ReadWritePaths=/var/lib/playcall-encoder

[Install]
WantedBy=multi-user.target
